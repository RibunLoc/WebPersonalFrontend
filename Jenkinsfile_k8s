pipeline {
    agent {
        kubernetes {
            defaultContainer 'node'
            yaml """
apiVersion: v1
kind: Pod
metadata:
  name: kaniko-pod
spec:
    affinity:
      nodeAffinity:
        requiredDuringSchedulingIgnoredDuringExecution:
          nodeSelectorTerms:
            - matchExpressions:
                - key: workload
                  operator: In
                  values:
                    - jenkins-agent
    restartPolicy: Never
    volumes:
      - name: docker-config
        secret:
          secretName: regcred
          items:
            - key: .dockerconfigjson
              path: config.json
    containers:
      - name: node
        image: node:20-bookworm
        command: ["cat"]
        tty: true
        resources:
          requests:
            memory: "256Mi"
            cpu: "128m"
          limits:
            memory: "512Mi"
            cpu: "1"

      - name: kaniko
        image: gcr.io/kaniko-project/executor:v1.23.2-debug
        command: ["/busybox/cat"]
        tty: true
        resources:
          requests:
            memory: "256Mi"
            cpu: "128m"
          limits:
            memory: "4Gi"
            cpu: "1.3"
        volumeMounts:
          - name: docker-config
            mountPath: /kaniko/.docker/
            readOnly: true

      - name: sonar
        image: eclipse-temurin:17-jre
        command: ["cat"]
        tty: true
        resources:
          requests:
            memory: "512Mi"
            cpu: "128m"
          limits:
            memory: "2Gi"
            cpu: "500m"

      - name: gitops
        image: alpine/git:2.47.2
        command: ["cat"]
        tty: true
        securityContext:
          runAsUser: 0
        resources:
          requests:
            memory: "64Mi"
            cpu: "50m"
          limits:
            memory: "256Mi"
            cpu: "500m"

      - name: yq
        image: mikefarah/yq:4.44.3
        command: ["cat"]
        tty: true
        securityContext:
          runAsUser: 0

"""
        }
    }

    parameters {
        string(name: 'nameImageBuild', defaultValue: 'harbor.holoc.id.vn/personal_frontend/web_frontend', description: "Docker registry to push the image")
        string(name: 'urlDomainHarbor', defaultValue: 'harbor.holoc.id.vn', description: "Domain of the Harbor registry")
        string(name: 'nameProject', defaultValue: 'personal_frontend', description: 'The project name on Harbor regitry')
        string(name: 'Tag', defaultValue: 'v1.2.0', description: 'Tag for the Docker image')
        string(name: 'VITE_API_BASE', defaultValue: 'https://api.holoc.id.vn', description: 'Base URL for the API')
        string(name: 'VITE_TURNSTILE_SITEKEY', defaultValue: '0x4AAAAAABsArAAHb5Qp1ZGS', description: 'Turnstile site key for the application')
        string(name: 'SENTRY_DSN', defaultValue: '', description: 'Sentry DSN for error tracking')

        booleanParam(name: 'RUN_SONAR', defaultValue: false, description: 'Run SonarCloud analysis')
        string(name: 'SONAR_HOST_URL', defaultValue: 'https://sonarcloud.io', description: 'Sonar host URL')
        string(name: 'SONAR_ORGANIZATION', defaultValue: 'thanhloc-org', description: 'SonarCloud organization key')
        string(name: 'SONAR_PROJECT_KEY', defaultValue: 'webpersonal-frontend', description: 'SonarCloud project key')
        string(name: 'SONAR_PROJECT_NAME', defaultValue: 'webpersonal-frontend', description: 'Sonar project name')
        string(name: 'SONAR_TOKEN_CRED_ID', defaultValue: 'sonarcloud-token', description: 'Jenkins credentialsId (Secret Text) for Sonar token')

        booleanParam(name: 'UPDATE_GITOPS', defaultValue: true, description: 'Commit/push image tag to GitOps repo for ArgoCD to sync')
        string(name: 'GITOPS_REPO_URL', defaultValue: 'https://github.com/RibunLoc/Kubernetes-Platform.git', description: 'GitOps repo URL (HTTPS)')
        string(name: 'GITOPS_BRANCH', defaultValue: 'main', description: 'GitOps branch to update')
        string(name: 'GITOPS_DEPLOYMENT_PATH', defaultValue: 'apps/team-frontend/personal/deployment.yaml', description: 'Path to deployment manifest in GitOps repo')
        string(name: 'GITOPS_CONTAINER_NAME', defaultValue: 'frontend', description: 'K8s container name to update image for in the Deployment')
        string(name: 'GITOPS_TOKEN_CRED_ID', defaultValue: 'github-token', description: 'Jenkins credentialsId (Secret Text) for GitOps repo push')
    }

    environment {
        GIT_REPO = ''
        GIT_BRANCH = 'develop'
    }

    stages {
	        stage('Checkout Git Hub') {
	            steps {
	                checkout scm
	            }
	        }
	        stage('SonarCloud Analysis') {
              when {
                expression { return params.RUN_SONAR }
              }
	            environment{
	              SCANNER_HOME = tool 'sonar-scanner-8'
	              SONAR_SCANNER_OPTS = '-Xms256m -Xmx1536m'
	            }
	            steps {
                container('sonar') {
                  withCredentials([string(credentialsId: params.SONAR_TOKEN_CRED_ID, variable: 'SONAR_TOKEN')]) {
                    catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                      sh '''
                        set -eu

                        if [ -z "${SONAR_TOKEN:-}" ]; then
                          echo "Missing SONAR token (credentialsId: ${SONAR_TOKEN_CRED_ID})"
                          exit 1
                        fi

                        $SCANNER_HOME/bin/sonar-scanner \
                          -Dsonar.host.url=${SONAR_HOST_URL} \
                          -Dsonar.login=${SONAR_TOKEN} \
                          -Dsonar.organization=${SONAR_ORGANIZATION} \
                          -Dsonar.projectName=${SONAR_PROJECT_NAME} \
                          -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                          -Dsonar.projectVersion=${Tag} \
                          -Dsonar.sources=src \
                          -Dsonar.exclusions="**/node_modules/**,**/dist/**,**/build/**" \
                          -Dsonar.typescript.tsconfigPath=tsconfig.json
                      '''
                    }
                  }
                }
	            }
	        }
	        stage('Build and Push Image') {
	            steps {
	                container('kaniko') {
	                  sh """
	                    /kaniko/executor \
	                      --context=dir://$WORKSPACE \
	                      --dockerfile=$WORKSPACE/Dockerfile \
	                      --destination=${params.nameImageBuild}:${params.Tag} \
	                      --destination=${params.nameImageBuild}:latest \
	                      --cache=true \
	                      --cache-repo=${params.nameImageBuild}/kaniko-cache
	                  """
	                }
	            }
	        }

	          stage('Update GitOps (ArgoCD)') {
	            when {
	              expression { return params.UPDATE_GITOPS }
	            }
	            steps {
                withCredentials([string(credentialsId: params.GITOPS_TOKEN_CRED_ID, variable: 'GITOPS_TOKEN')]) {
                  withEnv([
                    "IMAGE=${params.nameImageBuild}:${params.Tag}",
                    "GITOPS_REPO_URL=${params.GITOPS_REPO_URL}",
                    "GITOPS_BRANCH=${params.GITOPS_BRANCH}",
                    "GITOPS_DEPLOYMENT_PATH=${params.GITOPS_DEPLOYMENT_PATH}",
                    "GITOPS_CONTAINER_NAME=${params.GITOPS_CONTAINER_NAME}"
                  ]) {
                    container('gitops') {
                      sh '''
                        set -eu

                        if [ -z "${GITOPS_TOKEN:-}" ]; then
                          echo "Missing GITOPS_TOKEN (credentialsId: ${GITOPS_TOKEN_CRED_ID})"
                          exit 1
                        fi

                        case "${GITOPS_REPO_URL}" in
                          https://*) ;;
                          *)
                            echo "GITOPS_REPO_URL must be HTTPS (e.g. https://github.com/<org>/<repo>.git)"
                            exit 1
                            ;;
                        esac

                        rm -rf gitops-repo
                        AUTH_URL="$(echo "${GITOPS_REPO_URL}" | sed "s#^https://#https://${GITOPS_TOKEN}@#")"
                        git clone --depth 1 --branch "${GITOPS_BRANCH}" "${AUTH_URL}" gitops-repo

                        cd gitops-repo

                        if [ ! -f "${GITOPS_DEPLOYMENT_PATH}" ]; then
                          echo "Missing file in GitOps repo: ${GITOPS_DEPLOYMENT_PATH}"
                          exit 1
                        fi
                      '''
                    }

                    container('yq') {
                      sh '''
                        set -eu

                        cd gitops-repo

                        IMAGE="$(printf '%s' "${IMAGE}" | tr -d '\r\n')"
                        export IMAGE
                        export GITOPS_CONTAINER_NAME

                        yq -i e '(.spec.template.spec.containers[] | select(.name == strenv(GITOPS_CONTAINER_NAME)) | .image) = strenv(IMAGE)' "${GITOPS_DEPLOYMENT_PATH}"
                      '''
                    }

                    container('gitops') {
                      sh '''
                        set -eu

                        cd gitops-repo

                        git add "${GITOPS_DEPLOYMENT_PATH}"
                        if git diff --cached --quiet; then
                          echo "GitOps already up-to-date: ${IMAGE}"
                          exit 0
                        fi

                        git config user.email "jenkins-bot@local"
                        git config user.name "jenkins-bot"
                        git commit -m "deploy(webpersonal-frontend): ${IMAGE}"
                        git push origin "HEAD:${GITOPS_BRANCH}"
                      '''
                    }
                  }
                }
	            }
	          }
	    }
}
